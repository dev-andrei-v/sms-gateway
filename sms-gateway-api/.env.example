# Database
DATABASE_URL=jdbc:postgresql://db-host:5432/sms_gateway_demo
DATABASE_USERNAME=sms_gateway_user
DATABASE_PASSWORD=change-me

# OAuth2 / OIDC resource server
JWT_ISSUER_URI=https://identity.example.com/application/o/sms-gateway/

# Browser CORS, comma-separated if configured in deployment
SMS_GATEWAY_CORS_ALLOWED_ORIGINS=https://sms.example.com

# Android device WebSocket authentication
SMS_DEVICE_WS_SHARED_KEY=replace-with-a-long-random-string
SMS_DEVICE_WS_ACK_TIMEOUT=30

# Optional OTP sender integration
SMS_OTP_TEMPLATE=Your one-time authentication code is: {code}
AUTHENTIK_API_TOKEN=your_authentik_api_token